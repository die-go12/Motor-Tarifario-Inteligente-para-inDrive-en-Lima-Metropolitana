{
  "expo": {
    "name": "indrive-mobile",
    "slug": "indrive-mobile",
    "scheme": "indrive",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "pe.indrive.app",
      "supportsTablet": true,
