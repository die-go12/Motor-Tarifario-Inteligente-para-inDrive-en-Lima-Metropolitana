# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=admin
POSTGRES_PASSWORD=cambia-esta-clave
POSTGRES_DB=indrive

# JWT
JWT_ACCESS_SECRET=cambia-este-secreto-de-acceso
JWT_REFRESH_SECRET=cambia-este-secreto-de-refresh
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# Clave compartida ms-base <-> ms-pricing para endpoints internos (quote/settle)
INTERNAL_API_KEY=cambia-esta-clave-interna

# Puertos de los microservicios
MS_BASE_PORT=3001
MS_PRICING_PORT=3002
API_GATEWAY_PORT=3000
MS_INTEGRATION_PORT=3003
MS_REPORTS_PORT=3004

# URLs internas (gateway -> servicios, ms-base -> ms-pricing/integracion)
MS_PRICING_URL=http://localhost:3002
MS_BASE_URL=http://localhost:3001
MS_INTEGRATION_URL=http://localhost:3003
MS_REPORTS_URL=http://localhost:3004

# CORS: origenes permitidos por el gateway (separados por coma)
GATEWAY_CORS_ORIGINS=http://localhost:8080,http://localhost:5173

# Combustible (stub OSINERGMIN)
FUEL_PRICE_PER_GALLON=16.5

# Redis (bus de eventos del motor)
REDIS_HOST=localhost
REDIS_PORT=6379

# MongoDB (auditoría del motor)
MONGO_URI=mongodb://localhost:27017/indrive_audit
