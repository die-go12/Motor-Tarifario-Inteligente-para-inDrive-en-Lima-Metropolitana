# URL base para la API REST del microservicio ms-base (por defecto puerto 3001)
# - Para emuladores Android locales: usa http://10.0.2.2:3001
# - Para simuladores iOS locales o conexión por cable USB (adb reverse): usa http://localhost:3001
# - Para dispositivos físicos en la misma red Wi-Fi: usa la IP local de tu PC (ej: http://192.168.18.202:3001)
EXPO_PUBLIC_API_URL=http://localhost:3001

# URL base para los WebSockets (socket.io) del microservicio ms-base (puerto 3001)
EXPO_PUBLIC_WS_URL=http://localhost:3001

